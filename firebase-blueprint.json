{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfis de acesso e permissões granulares (Sócio, Diretor ou Gerente) da Creps Urca.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário no Firebase Auth."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 150,
          "description": "E-mail de acesso do usuário."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Nome completo ou de exibição do membro da equipe."
        },
        "role": {
          "type": "string",
          "enum": ["socio", "diretor", "gerente", "master", "manager"],
          "description": "Nível de permissão: socio, diretor (acesso total) ou gerente (abas e edições configuráveis)."
        },
        "allowedTabs": {
          "type": "array",
          "description": "Lista de abas visíveis para o usuário (aplicada a Gerente)."
        },
        "editableTabs": {
          "type": "array",
          "description": "Lista de abas em que o Gerente possui permissão de alteração."
        },
        "active": {
          "type": "boolean",
          "description": "Indica se o acesso do usuário está ativo."
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do Sócio ou Diretor que criou o acesso."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na criação."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na última atualização."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "allowedTabs",
        "editableTabs",
        "active",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "PartnerRecord": {
      "title": "PartnerRecord",
      "description": "Registro não-sensível dos Sócios cadastrados para seleção em Aporte por Sócios e Pagamentos.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "enum": ["creps-urca"],
          "description": "Identificador do workspace da loja."
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do Sócio."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Nome do Sócio."
        },
        "active": {
          "type": "boolean",
          "description": "Indica se o Sócio está ativo."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["workspaceId", "uid", "displayName", "active", "createdAt", "updatedAt"]
    },
    "TransitionTask": {
      "title": "TransitionTask",
      "description": "Atividade do checklist de transição administrativa da loja Creps Urca.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "enum": ["creps-urca"],
          "description": "Identificador do workspace da loja."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "description": "Título curto da atividade."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Detalhes operacionais e observações da tarefa."
        },
        "category": {
          "type": "string",
          "enum": [
            "RH & Equipe",
            "Sistemas & PDV",
            "Financeiro & Bancos",
            "Estoque & Inventário",
            "Jurídico & Contábil",
            "Operacional"
          ],
          "description": "Área responsável pela atividade."
        },
        "assigneeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Nome do responsável atribuído."
        },
        "dueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Data limite para conclusão (YYYY-MM-DD)."
        },
        "status": {
          "type": "string",
          "enum": ["pendente", "em_andamento", "concluido"],
          "description": "Status atual da atividade."
        },
        "priority": {
          "type": "string",
          "enum": ["baixa", "media", "alta", "urgente"],
          "description": "Prioridade da tarefa."
        },
        "completedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Data/hora ISO de conclusão ou string vazia."
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do autor da tarefa."
        },
        "createdByName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Nome do autor da tarefa."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "title",
        "description",
        "category",
        "assigneeName",
        "dueDate",
        "status",
        "priority",
        "completedAt",
        "createdByUid",
        "createdByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "TransitionPayment": {
      "title": "TransitionPayment",
      "description": "Pagamento pré-operacional ou de normalização da Creps Urca.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "enum": ["creps-urca"]
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "amount": {
          "type": "number"
        },
        "paidBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Nome do Sócio ou conta pagadora."
        },
        "category": {
          "type": "string",
          "enum": [
            "Equipamentos & PDV",
            "RH & Exames",
            "Taxas & Registros",
            "Estoque Inicial",
            "Reforma & Estrutura",
            "Serviços & Sistemas",
            "Outros"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["PIX", "Cartão Corporativo", "Transferência", "Boleto", "Dinheiro"]
        },
        "paymentDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["pago", "agendado"]
        },
        "receiptRef": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "description",
        "amount",
        "paidBy",
        "category",
        "paymentMethod",
        "paymentDate",
        "status",
        "receiptRef",
        "notes",
        "createdByUid",
        "createdByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryPeriod": {
      "title": "InventoryPeriod",
      "description": "Fechamento mensal do inventário com datas validadas de Base/Hoje e fluxo de aprovação por Sócios e Diretores.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "enum": ["creps-urca"]
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "Mês de referência (YYYY-MM)."
        },
        "baseDate": {
          "type": "string",
          "maxLength": 10,
          "description": "Data validada da Quantidade Base (YYYY-MM-DD ou vazio)."
        },
        "currentDate": {
          "type": "string",
          "maxLength": 10,
          "description": "Data validada da Quantidade Hoje (YYYY-MM-DD ou vazio)."
        },
        "baseValidated": {
          "type": "boolean"
        },
        "currentValidated": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["rascunho", "aguardando_validacao", "aprovado", "recusado"]
        },
        "submittedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "submittedByName": {
          "type": "string",
          "maxLength": 80
        },
        "submittedAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "reviewedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "reviewedByName": {
          "type": "string",
          "maxLength": 80
        },
        "reviewedAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 300
        },
        "carriedFromMonth": {
          "type": "string",
          "maxLength": 7
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "monthKey",
        "baseDate",
        "currentDate",
        "baseValidated",
        "currentValidated",
        "status",
        "submittedByUid",
        "submittedByName",
        "submittedAtIso",
        "reviewedByUid",
        "reviewedByName",
        "reviewedAtIso",
        "rejectionReason",
        "carriedFromMonth",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Ingrediente ou item de embalagem do inventário mensal com quantidade base e quantidade hoje.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "enum": ["creps-urca"]
        },
        "periodId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "Proteínas",
            "Queijos",
            "Estoque Seco",
            "Hortifruti",
            "Doces",
            "Embalagem",
            "Outros Congelados e Resfriados",
            "Molhos",
            "Basicos Delivery",
            "Polpas e Açaí"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "baseQty": {
          "type": "number"
        },
        "currentQty": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "sortOrder": {
          "type": "number"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "periodId",
        "monthKey",
        "name",
        "category",
        "unit",
        "baseQty",
        "currentQty",
        "notes",
        "sortOrder",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro imutável de auditoria para todas as alterações no banco de dados.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "enum": ["creps-urca"]
        },
        "entityType": {
          "type": "string",
          "enum": ["task", "payment", "user", "inventory", "partner", "system"]
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"]
        },
        "summary": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "actorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "changedFields": {
          "type": "array"
        },
        "amount": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "enum": ["client_atomic_batch", "cloud_function_trigger"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "entityType",
        "entityId",
        "action",
        "summary",
        "actorUid",
        "actorEmail",
        "actorName",
        "changedFields",
        "amount",
        "source",
        "timestamp"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfis de acesso e permissões (Sócio, Diretor, Gerente) da Creps Urca."
    },
    "/partners/{partnerId}": {
      "schema": { "$ref": "#/entities/PartnerRecord" },
      "description": "Lista não-sensível de Sócios cadastrados para exibição e filtro em Aporte por Sócios."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TransitionTask" },
      "description": "Atividades e prazos da transição administrativa da loja da Urca."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/TransitionPayment" },
      "description": "Pagamentos e custos pré-operacionais realizados pelos sócios."
    },
    "/inventory_periods/{periodId}": {
      "schema": { "$ref": "#/entities/InventoryPeriod" },
      "description": "Períodos mensais de inventário com datas Base/Hoje validadas e fluxo de aprovação."
    },
    "/inventory_items/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Itens e quantidades mensais do inventário de ingredientes da Creps Urca."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Coleção dedicada e imutável de logs de auditoria."
    }
  }
}
